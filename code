<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>I love you Mummy and Pappa</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;1,9..144,500&display=swap" rel="stylesheet">
<style>
  *{ margin:0; padding:0; box-sizing:border-box; }

  html, body{
    height: 100%;
    background: #0E0E0E;
  }

  body{
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    font-family: 'Fraunces', serif;
  }

  .frame{
    position: relative;
    width: 100%;
    max-width: 480px;
    min-height: 100vh;
    overflow: hidden;
  }

  .photo{
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  .veil{
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 45%, rgba(0,0,0,0.75) 78%, rgba(0,0,0,0.92) 100%);
  }

  .content{
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 28px 24px 26px;
    opacity: 0;
    animation: rise 0.9s ease-out 0.3s forwards;
  }

  @keyframes rise{
    from{ opacity: 0; transform: translateY(14px); }
    to{ opacity: 1; transform: translateY(0); }
  }

  .message{
    color: #FBF7EE;
    font-size: 26px;
    font-style: italic;
    font-weight: 500;
    line-height: 1.4;
    text-align: center;
    text-shadow: 0 2px 12px rgba(0,0,0,0.5);
    margin-bottom: 22px;
  }

  .player-wrap{
    border-radius: 12px;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce){
    .content{ animation: none; opacity: 1; transform: none; }
  }
</style>
</head>
<body>
  <div class="frame">
    <img class="photo" src="data:image/jpeg;base64," alt="Family photo">
    <div class="veil"></div>
    <div class="content">
      <p class="message">I love you mummy and pappa</p>
      <div class="player-wrap">
        <iframe style="border-radius:12px" src="https://open.spotify.com/embed/track/46jVr8q0uzUz9HIxQmjin4?utm_source=generator&theme=0" width="100%" height="152" frameBorder="0" allowfullscreen="" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
      </div>
    </div>
  </div>
</body>
</html>
